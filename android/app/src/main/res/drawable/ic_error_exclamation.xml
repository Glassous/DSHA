<!--
  错误圆内部的感叹号：只画图形本身，颜色由 Icon 的 tint 决定。
  实心圆的颜色与之不同，而单个 vector 的 tint 会覆盖全部 path，因此必须拆成「圆 + 感叹号」两层。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF000000"
        android:pathData="M10,3h4v10h-4zM10,17h4v4h-4z" />
</vector>
